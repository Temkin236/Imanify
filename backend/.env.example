# Backend Environment Configuration - Example
# Copy this to .env and fill in actual values

# ======================================
# SERVER CONFIGURATION
# ======================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ======================================
# CORS CONFIGURATION
# ======================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ======================================
# API CONFIGURATION
# ======================================
ALQURAN_API_TIMEOUT=5000
API_CACHE_TTL_HOURS=24

# ======================================
# AI PROVIDERS - CLOUD BASED (Optimized for Ethiopia)
# ======================================
# Ollama has been replaced with cloud providers
# Choose at least ONE provider below

# OPTION 1: OpenRouter (RECOMMENDED)
# ✅ Free tier available | ✅ No credit card required
# 📌 Sign up: https://openrouter.ai/auth/signup
OPENROUTER_API_KEY=

# OPTION 2: Groq (Ultra-fast alternative)
# ✅ Free tier: 8,000 requests/day | ✅ ~100ms latency
# 📌 Sign up: https://console.groq.com/auth/signup
GROQ_API_KEY=

# OPTION 3: Gemini (Google's API - Fallback)
# ✅ Free tier: 60 req/min | ✅ Highly reliable
# 📌 Sign up: https://ai.google.dev
GEMINI_API_KEY=

# ======================================
# DATABASE (for future features)
# ======================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imanify
DB_USER=postgres
DB_PASSWORD=

# ======================================
# RATE LIMITING
# ======================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ======================================
# LOGGING
# ======================================
LOG_FILE_PATH=./logs/server.log
